# Copy to /etc/pgbackrest/pgbackrest.conf; set owner postgres and mode 0600.
# Replace every __PLACEHOLDER__ from approved secret/config management.
[global]
repo1-type=s3
repo1-s3-bucket=__PRIMARY_BUCKET__
repo1-s3-region=eu-central-003
repo1-s3-endpoint=s3.eu-central-003.backblazeb2.com
repo1-s3-uri-style=host
repo1-s3-key-type=shared
repo1-s3-key=__B2_APPLICATION_KEY_ID__
repo1-s3-key-secret=__B2_APPLICATION_KEY_SECRET__
repo1-path=/multilingual-platform
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=__INJECT_FROM_SECRET_MANAGER__
repo1-retention-full=4
repo1-retention-diff=14
repo1-retention-history=365
start-fast=y
archive-async=y
spool-path=/var/spool/pgbackrest
log-level-console=info
log-level-file=detail
process-max=2

[platform]
pg1-path=/var/lib/postgresql/16/main
pg1-port=5432
pg1-user=pgbackrest
