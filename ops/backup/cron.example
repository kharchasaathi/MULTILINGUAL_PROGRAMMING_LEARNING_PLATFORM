# Install only after AWS, pgBackRest and PostgreSQL archive configuration pass validation.
# Full backup Sunday 02:00 UTC; differential backup other days 02:00 UTC.
0 2 * * 0 postgres PGBACKREST_BACKUP_TYPE=full /opt/platform/ops/backup/run-pgbackrest-backup.sh
0 2 * * 1-6 postgres PGBACKREST_BACKUP_TYPE=diff /opt/platform/ops/backup/run-pgbackrest-backup.sh
*/15 * * * * postgres /opt/platform/ops/backup/check-backup-freshness.sh
