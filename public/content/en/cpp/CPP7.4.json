  "assessment": {
    "questions": [
      {
        "id": "cpp7.4-q1",
        "prompt": "g[r][c] selects?",
        "options": [
          "Row r, column c",
          "Column r, row c",
          "Only row"
        ],
        "answer": "Row r, column c",
        "explanation": "First index row; second column."
      },
      {
        "id": "cpp7.4-q2",
        "prompt": "2D traversal usually uses?",
        "options": [
          "Nested loops",
          "Single if",
          "No index"
        ],
        "answer": "Nested loops",
        "explanation": "Separate row and column loops."
      },
      {
        "id": "cpp7.4-q3",
        "prompt": "Row accumulator resets?",
        "options": [
          "Each row iteration",
          "Only at program start",
          "After final row"
        ],
        "answer": "Each row iteration",
        "explanation": "Each row needs a fresh sum."
      },
      {
        "id": "cpp7.4-q4",
        "prompt": "Rows of 2-row array?",
        "options": [
          "0 and 1",
          "1 and 2",
          "0,1,2"
        ],
        "answer": "0 and 1",
        "explanation": "Two rows have indexes zero and one."
      },
      {
        "id": "cpp7.4-q5",
        "prompt": "Main diagonal expression?",
        "options": [
          "m[i][i]",
          "m[i][0]",
          "m[0][i]"
        ],
        "answer": "m[i][i]",
        "explanation": "Same row and column index."
      }
    ]
  },
